# ============================================================
# HOMOLOGAÇÃO (staging) — Crédito Rápido
# ============================================================
# Copie para .env.homologacao (ou cadastre na Vercel do projeto de
# HOMOLOGAÇÃO) e preencha com os valores do projeto Supabase SEPARADO,
# criado só para testes. NUNCA use valores de produção aqui.
#
# Todos vêm do projeto Supabase EXCLUSIVO de homologação
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta, só no servidor (crons, backup, auditoria de login).
SUPABASE_SERVICE_ROLE_KEY=

# Segredos PRÓPRIOS da homologação — gere novos, diferentes dos de produção:
#   openssl rand -hex 32
CRON_SECRET=
BACKUP_REPORT_SECRET=

# ------------------------------------------------------------
# Integrações externas DESLIGADAS em homologação.
# Não configure provedor real de WhatsApp. O seed já insere uma
# message_settings com is_active=false apontando para um host fictício,
# então nenhum disparo real acontece. Deixe sem credenciais reais.
# ------------------------------------------------------------
