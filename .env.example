# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes no
# painel da Vercel (produção). NUNCA versione valores reais.
# Todos vêm do projeto Supabase EXCLUSIVO deste sistema (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta, só no servidor: crons, relatório de backup e auditoria de login.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo aleatório (ex.: openssl rand -hex 32). Sem ele as rotas /api/cron/* respondem 401.
CRON_SECRET=
# Só se o backup automático (BACKUP.md) estiver ativo.
BACKUP_REPORT_SECRET=
